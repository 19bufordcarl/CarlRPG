\PassOptionsToPackage{table}{xcolor}
\documentclass[12pt,letterpaper,twocolumn,openany,nodeprecatedcode,bg=none]{dndbook}
\usepackage[english]{babel}
\usepackage[utf8]{inputenc}
\usepackage{longtable,booktabs,array}
\usepackage{calc}
\usepackage{etoolbox}
\usepackage{caption}
\usepackage{float}
\usepackage{graphicx}
\usepackage{needspace}

% Zebra striping, reset per table
\AtBeginEnvironment{longtable}{\rowcolors{1}{white}{gray!10}\small}
\AtBeginEnvironment{table}{\rowcolors{1}{white}{gray!10}}

% Pandoc helpers
\providecommand{\pandocbounded}[1]{#1}
\providecommand{\tightlist}{%
  \setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}

% Layout tweaks
\captionsetup{labelformat=empty}
\setcounter{secnumdepth}{0}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.5\baselineskip}
\setlength{\headheight}{15pt}

% Prevent orphaned subsection headings
\let\oldsubsection\subsection
\renewcommand{\subsection}[1]{%
  \needspace{5\baselineskip}%
  \oldsubsection{#1}%
}

\begin{document}

% ===== FRONT MATTER (single column) =====
\onecolumn

\begin{titlepage}
  \thispagestyle{empty}
  \centering
  $if(coverart)$
    \includegraphics[width=\textwidth,height=0.7\textheight,keepaspectratio]{$coverart$}\par
    \vspace{0.8cm}
  $endif$
  {\Huge\scshape $title$}\par
  \vspace{0.4cm}
  $if(author)$
    {\large $author$}\par
    \vspace{0.6cm}
  $endif$
  $if(tagline)$
    {\large\itshape $tagline$}\par
  $endif$
  \vfill
\end{titlepage}

$if(splashart)$
  \begin{center}
    \includegraphics[width=0.9\textwidth,keepaspectratio]{$splashart$}\par
    $if(splashart-caption)$
      \vspace{0.4cm}
      {\itshape $splashart-caption$}\par
    $endif$
  \end{center}
$endif$

% ===== BODY (two column) =====
\twocolumn

$body$

% ===== END MATTER (single column) =====
\onecolumn

$if(endart)$
  \begin{center}
    \includegraphics[width=0.7\textwidth,keepaspectratio]{$endart$}\par
    $if(endart-caption)$
      \vspace{0.4cm}
      {\itshape $endart-caption$}\par
    $endif$
  \end{center}
$endif$

\end{document}