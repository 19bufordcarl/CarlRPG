\PassOptionsToPackage{table}{xcolor}
\documentclass[12pt,letterpaper,twocolumn,openany,nodeprecatedcode,bg=none]{dndbook}
\usepackage[english]{babel}
\usepackage[utf8]{inputenc}
\usepackage{longtable,booktabs,array}
\usepackage{calc}
\usepackage{etoolbox}
\usepackage{caption}
\usepackage{float}

% Attempt 'smart' pagebreaks for spacing
\usepackage{needspace}
\let\oldsubsection\subsection
\renewcommand{\subsection}[1]{%
  \needspace{5\baselineskip}%
  \oldsubsection{#1}%
}

% Table setup for small tables with stripes
\AtBeginEnvironment{longtable}{\rowcolors{1}{white}{gray!20}\small}
\AtBeginEnvironment{table}{\rowcolors{1}{white}{gray!20}}

% Fix for Pandoc 3.1.7+ image handling
\providecommand{\pandocbounded}[1]{#1}

% Pandoc's compact list helper
\providecommand{\tightlist}{%
  \setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}

% Remove "Figure N:" prefix from captions
\captionsetup{labelformat=empty}

% Remove section numbering
\setcounter{secnumdepth}{0}

% Remove leading paragraph indent
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.5\baselineskip}

% Fix fancyhdr \headheight warning
\setlength{\headheight}{15pt}

\begin{document}

$if(title)$
\begin{titlepage}
  \thispagestyle{empty}
  \centering
  $if(coverart)$
    \includegraphics[width=\textwidth,height=0.65\textheight,keepaspectratio]{$coverart$}\par
    \vspace{1.2cm}
  $endif$
  {\Huge\scshape $title$}\par
  \vspace{0.4cm}
  $if(author)$
    {\large\itshape $author$}\par
  $endif$
  \vfill
  $if(tagline)$
    {\large\itshape $tagline$}\par
    \vspace{0.5cm}
  $endif$
\end{titlepage}
$endif$

$body$

\end{document}