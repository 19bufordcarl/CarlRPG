\PassOptionsToPackage{table}{xcolor}
\documentclass[12pt,letterpaper,twocolumn,openany,nodeprecatedcode,bg=none]{dndbook}
\usepackage[english]{babel}
\usepackage[utf8]{inputenc}
\usepackage{longtable,booktabs,array}
\usepackage{calc}
\usepackage{etoolbox}
\usepackage{caption}
\usepackage{float}
\usepackage{graphicx}
\usepackage{needspace}
\usepackage{tikz}

% Reset zebra striping at the start of every table
\AtBeginEnvironment{longtable}{\rowcolors{1}{white}{gray!10}\small}
\AtBeginEnvironment{table}{\rowcolors{1}{white}{gray!10}}

\providecommand{\pandocbounded}[1]{#1}
\providecommand{\tightlist}{%
  \setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}

\captionsetup{labelformat=empty}
\setcounter{secnumdepth}{0}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.5\baselineskip}
\setlength{\headheight}{15pt}

% Prevent orphaned subsections
\let\oldsubsection\subsection
\renewcommand{\subsection}[1]{%
  \needspace{5\baselineskip}%
  \oldsubsection{#1}%
}

\begin{document}
\onecolumn

$if(title)$
  $if(coverart)$
    \title{\includegraphics[width=0.9\textwidth,height=0.55\textheight,keepaspectratio]{$coverart$}\\[1.5cm]$title$}
  $else$
    \title{$title$}
  $endif$
$endif$
$if(author)$\author{$author$}$endif$
\date{}
\maketitle

$if(tagline)$
\clearpage
\thispagestyle{empty}
\null\vfill
\begin{center}{\Large\itshape $tagline$}\end{center}
\vfill
$endif$

$if(splashart)$
\clearpage
\thispagestyle{empty}
\begin{center}
\vspace*{\fill}
\includegraphics[width=\textwidth,height=0.85\textheight,keepaspectratio]{$splashart$}\par
$if(splashart-caption)$
\vspace{0.4cm}
{\itshape $splashart-caption$}\par
$endif$
\vspace*{\fill}
\end{center}
$endif$

\clearpage
\twocolumn

$body$

\onecolumn

$if(endart)$
\clearpage
\thispagestyle{empty}
\begin{center}
\vspace*{\fill}
\includegraphics[width=0.7\textwidth,keepaspectratio]{$endart$}\par
$if(endart-caption)$
\vspace{0.4cm}
{\itshape $endart-caption$}\par
$endif$
\vspace*{\fill}
\end{center}
$endif$

\end{document}